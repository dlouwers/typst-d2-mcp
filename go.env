# Go environment for Dependabot's gomod updates, which read this file as
# GOENV (dependabot-core go_modules/file_parser.rb). Nothing else does: the
# go command only reads $GOROOT/go.env and the user config, so local builds
# and CI are unaffected; CI sets the same values in
# .github/actions/design-system-auth.
#
# The private module github.com/dlouwers/stormlantern-design-system comes
# from Google Artifact Registry (dlouwers/experiments#526); Dependabot's proxy
# authenticates to it through the go-stormlantern registry in
# .github/dependabot.yml. GOPROXY is set here, rather than left to Dependabot,
# because Dependabot's own value is the registry plus `direct`, without the
# public proxy. GONOSUMDB, because the module is not in the public checksum
# database; go.sum still pins its hash. GOPRIVATE empty, because it would
# send the module past every proxy to github.com, which Dependabot cannot read.
GOPROXY=https://europe-west4-go.pkg.dev/homelab-495021/go-stormlantern,https://proxy.golang.org,direct
GONOSUMDB=github.com/dlouwers/stormlantern-design-system
GOPRIVATE=
