// typst-d2-mcp devcontainer.
//
// A plain Debian base plus features: nothing bespoke, and every tool
// versioned independently. Go is a feature rather than a base image, so
// bumping the toolchain is a one-line change here.
//
// Only official devcontainers/features are used. The devcontainers-extra
// ones for bun and apt packages are both built on nanolayer, which
// leaves /tmp as root:root 0755 instead of sticky 1777 — enough to break
// `go build`, whose work directory lives there, and enough to make a
// later feature fail outright on `apt`. Those two tools are installed in
// post-create.sh instead.
{
  "name": "typst-d2-mcp",
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  "features": {
    // Kept on the same minor as CI's setup-go. go.mod's `go` directive
    // is the *language* version, enforced by the compiler whatever
    // toolchain runs it, so this may run ahead of it without letting
    // newer syntax slip past CI.
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26"
    },
    // kubectl for inspecting the test deployment. The runtime image has
    // no sqlite3, so reading auth.sqlite means `kubectl exec -- cat`
    // out to the host and querying it locally. Helm and minikube unused.
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "helm": "none",
      "minikube": "none"
    },
    // gh for the PR/issue workflow this repo runs on.
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Node for the Playwright suite under playwright/: its CLI is a Node
    // script whose workers fork node, so bun alone is not enough.
    // (bun and sqlite3 are in post-create — see the note there.)
    "ghcr.io/devcontainers/features/node:1": {}
  },
  // kubectl-helm-minikube must be installed last. Adding it flips /tmp
  // from sticky 1777 to 0755 (measured: base+go+github-cli leaves 1777,
  // adding this one leaves 0755 — the script contains no such chmod, so
  // it appears to be a layer-commit interaction rather than an explicit
  // one). Any apt-using feature installed after it then dies on
  //   Unable to mkstemp /tmp/apt.sig.… (13: Permission denied)
  // which took out node and go in turn. post-create.sh restores the mode
  // for runtime, where `go build` needs /tmp for its work directory.
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/github-cli",
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/devcontainers/features/go",
    "ghcr.io/devcontainers/features/kubectl-helm-minikube"
  ],
  "mounts": [
    // Read-only: enough to inspect the cluster, not to be surprised by
    // an accidental write. Sealing secrets stays in the experiments
    // repo, where kubeseal and the seal-*.nu scripts live.
    "source=${localEnv:HOME}/.kube,target=/home/vscode/.kube,type=bind,consistency=cached,readonly",
    // The host's gh login, so the Go toolchain can fetch the private
    // stormlantern-design-system module (#82). post-create.sh runs
    // `gh auth setup-git`, which makes gh git's credential helper.
    //
    // Mounted rather than injected as a token env var, as in investor-buddy:
    // the host token is a refreshable gho_, and a containerEnv copy is frozen
    // at create time, while a mount reads the live file. An env var would
    // also be visible to every install hook post-create runs (bun install,
    // the Playwright download); git reaches for this only when it fetches.
    //
    // readonly holds because GH_NO_UPDATE_NOTIFIER below stops the
    // background update check, the only thing gh routinely writes here.
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-playwright.playwright"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": true
      }
    }
  },
  "containerEnv": {
    "KUBECONFIG": "/home/vscode/.kube/config",
    // Let `go install` fetch a newer toolchain when a tool needs one.
    "GOTOOLCHAIN": "auto",
    // Configuration, not a credential. Fetches the private design-system
    // module straight from github.com with the gh credential, off the public
    // proxy and checksum database. CI instead reads it from Artifact Registry
    // through WIF (.github/actions/design-system-auth); both serve the same
    // tagged tree, so go.sum agrees either way.
    "GOPRIVATE": "github.com/dlouwers/*",
    // Stops gh writing state.yml to its config dir, which is what lets the
    // gh mount above stay readonly.
    "GH_NO_UPDATE_NOTIFIER": "1"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode"
}
