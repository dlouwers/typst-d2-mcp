# Non-secret runtime configuration, in dotenv form so kustomize's
# configMapGenerator can hash it. Credentials and tokens live in the
# sealed secret in each overlay.
#
# Values are unquoted on purpose: dotenv treats quotes as literal
# characters, so TYPST_D2_MCP_ADDR=":8080" would set the port to
# `":8080"` — quotes and all.

TYPST_D2_MCP_TRANSPORT=http
TYPST_D2_MCP_ADDR=:8080
TYPST_D2_MCP_PATH=/mcp
TYPST_D2_MCP_METRICS_ADDR=:9090
TYPST_D2_MCP_WORKSPACE=/var/lib/typst-d2-mcp/workspaces
TYPST_D2_MCP_DB=/var/lib/typst-d2-mcp/auth.sqlite
# House templates are seeded here (beside workspaces/, so the sweeper does
# not purge them) from the binary on startup and resolved by typst as
# $XDG_DATA_HOME/typst/packages/<owner>/<name>/<version>. Edit them on the
# volume to change house style without an image rebuild (#63 step 2).
XDG_DATA_HOME=/var/lib/typst-d2-mcp/data
TYPST_D2_MCP_AUTH=github
TYPST_D2_MCP_PUBLIC_URL=https://typst-d2-mcp.stormlantern.nl
TYPST_D2_MCP_QUOTA_PER_DAY=1
TYPST_D2_MCP_COMPILE_TIMEOUT=30s
TYPST_D2_MCP_MAX_INPUT_BYTES=1048576

# Workspaces are scratch space: a week is far longer than any PDF link
# TTL, so nothing in flight is at risk, and it bounds the PVC. 0 would
# disable the file purge (sizes are still measured).
TYPST_D2_MCP_WORKSPACE_TTL=168h
TYPST_D2_MCP_SWEEP_INTERVAL=1h

TYPST_D2_MCP_LOG_FORMAT=json
TYPST_D2_MCP_LOG_LEVEL=info
