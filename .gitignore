# .gitignore for typst-d2-mcp

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
dist/
build/

# Typst output
*.pdf

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Test files
test-*.typ
test-*.pdf
*-processed.typ

# Go
/typst-d2-prep
/typst-d2-mcp
# Scratch binaries built for local experiments. A 26MB build artefact
# reached main once already, swept in by a broad `git add`; the pattern
# is here so it cannot happen from a filename nobody remembered.
/.research-mcpd
/.mcpd-*
/.fontcheck/
*.test
*.out
coverage.txt

# Temporary files
*.tmp
