{{/*
  The users table lives here rather than in the page template so that
  both the full page render and the htmx action responses can emit it
  from their own template sets.

  Note which elements are which: sl-table, sl-badge and sl-alert are
  display-only wrappers, so with JavaScript off they render as unknown
  elements and their contents still show. Form controls are deliberately
  native <input>/<button> rather than sl-input/sl-button — those are
  form-associated custom elements that submit via ElementInternals, which
  needs JavaScript. Native controls keep every action working when it is
  unavailable.
*/}}
{{define "users-table"}}
<sl-table id="users" density="compact" zebra>
  <table>
    <thead>
      <tr>
        <th>Login</th>
        <th>State</th>
        <th class="num">Today</th>
        <th>Quota</th>
        <th>Key</th>
        <th class="num">Storage</th>
        <th>Budget</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
    {{range .Rows}}
      <tr>
        <td>
          <strong>{{.GitHubLogin}}</strong>
          {{if .Email}}<div class="muted">{{.Email}}</div>{{end}}
        </td>
        <td>
          {{if .SignedIn}}<sl-badge variant="ok">active</sl-badge>
          {{else}}<sl-badge variant="warn">invited</sl-badge>{{end}}
          {{if and .Invited .InvitedBy}}<div class="muted">by {{.InvitedBy}}</div>{{end}}
        </td>
        <td class="num">{{if .SignedIn}}{{.UsedToday}}{{else}}—{{end}}</td>
        <td>{{quotaLabel .QuotaOverride $.DefaultQuota}}</td>
        <td>
          {{if gt .KeyCount 0}}
            <sl-badge variant="info">{{.KeyCount}}</sl-badge>
            <div class="muted">used {{agoLabel .LastUsedAt}}</div>
          {{else}}
            <span class="muted">none</span>
          {{end}}
        </td>
        <td class="num">
          {{bytesLabel .StorageBytes}}
          {{if .StorageMeasAt}}<div class="muted">{{agoLabel .StorageMeasAt}}</div>{{end}}
        </td>
        <td>{{budgetLabel .BudgetOverride $.DefaultBudget}}</td>
        <td class="actions">
          <details>
            <summary>Manage</summary>
            <div class="panel">

              {{if .SignedIn}}
              <form method="post" action="/admin/quota" hx-post="/admin/quota" hx-target="#users" hx-swap="outerHTML">
                <input type="hidden" name="login" value="{{.GitHubLogin}}">
                <fieldset>
                  <legend>Quota</legend>
                  <label><input type="radio" name="mode" value="default" {{if not .QuotaOverride}}checked{{end}}> Default</label>
                  <label><input type="radio" name="mode" value="unlimited" {{if and .QuotaOverride (eq (deref .QuotaOverride) 0)}}checked{{end}}> Unlimited</label>
                  {{/*
                    No min/required on this field. It is validated by the
                    browser whatever mode is selected, and there is no way to
                    disable it conditionally without JavaScript — which this
                    form deliberately does not depend on. A constraint here
                    blocks saving Default or Unlimited whenever the box holds
                    a value the constraint rejects. The server validates the
                    number instead, and says so in the flash.
                  */}}
                  <label><input type="radio" name="mode" value="fixed"> Fixed
                    <input type="number" name="value" inputmode="numeric" placeholder="10" value="{{quotaValue .QuotaOverride}}" class="narrow">
                  </label>
                  <button type="submit" class="btn btn-primary btn-sm">Save quota</button>
                </fieldset>
              </form>

              <form method="post" action="/admin/budget" hx-post="/admin/budget" hx-target="#users" hx-swap="outerHTML">
                <input type="hidden" name="login" value="{{.GitHubLogin}}">
                <fieldset>
                  <legend>Storage budget</legend>
                  <label><input type="radio" name="mode" value="default" {{if not .BudgetOverride}}checked{{end}}> Default</label>
                  <label><input type="radio" name="mode" value="unlimited" {{if and .BudgetOverride (eq (deref64 .BudgetOverride) 0)}}checked{{end}}> Unlimited</label>
                  {{/* Same no-constraint reasoning as the quota field above. */}}
                  <label><input type="radio" name="mode" value="fixed"> Fixed
                    <input type="number" name="value" inputmode="numeric" placeholder="52428800" value="{{budgetValue .BudgetOverride}}" class="narrow"> bytes
                  </label>
                  <button type="submit" class="btn btn-primary btn-sm">Save budget</button>
                </fieldset>
              </form>

              <form method="post" action="/admin/reset" hx-post="/admin/reset" hx-target="#users" hx-swap="outerHTML">
                <input type="hidden" name="login" value="{{.GitHubLogin}}">
                <input type="hidden" name="user_id" value="{{.UserID}}">
                <button type="submit" class="btn btn-sm">Reset today's counter</button>
              </form>

              <form method="post" action="/admin/revoke-keys" hx-post="/admin/revoke-keys" hx-target="#users" hx-swap="outerHTML">
                <input type="hidden" name="login" value="{{.GitHubLogin}}">
                <button type="submit" class="btn btn-sm">Revoke API keys</button>
              </form>
              {{end}}

              {{if .Invited}}
              <form method="post" action="/admin/revoke" hx-post="/admin/revoke" hx-target="#users" hx-swap="outerHTML">
                <input type="hidden" name="login" value="{{.GitHubLogin}}">
                <button type="submit" class="btn btn-sm">Revoke access</button>
              </form>
              {{end}}

              <form method="post" action="/admin/delete" hx-post="/admin/delete" hx-target="#users" hx-swap="outerHTML" class="danger">
                <input type="hidden" name="login" value="{{.GitHubLogin}}">
                <label>Type <code>{{.GitHubLogin}}</code> to confirm deletion
                  <input type="text" name="confirm" autocomplete="off" placeholder="{{.GitHubLogin}}">
                </label>
                <button type="submit" class="btn btn-danger btn-sm">Delete user and all data</button>
              </form>

            </div>
          </details>
        </td>
      </tr>
    {{else}}
      <tr><td colspan="8" class="muted">Nobody yet. Invite someone above.</td></tr>
    {{end}}
    </tbody>
  </table>
</sl-table>
{{end}}

{{/*
  The organisations list, in partials so both the full page render and the
  htmx action responses can emit it. Native form controls throughout, so
  every action still works with JavaScript off — same discipline as the
  users table above.
*/}}
{{define "orgs-list"}}
<div id="orgs">
{{range .Orgs}}
  <sl-card padding="lg" class="org">
    <div slot="header" class="org-head">
      <span><code>@{{.Slug}}</code>{{if .DisplayName}} — {{.DisplayName}}{{end}}</span>
      <sl-badge variant="info">{{.MemberCount}} member{{if ne .MemberCount 1}}s{{end}}</sl-badge>
    </div>

    {{$slug := .Slug}}
    <table class="members">
      <tbody>
      {{range .Members}}
        <tr>
          <td>
            <strong>{{.GitHubLogin}}</strong>{{if .Email}} <span class="muted">{{.Email}}</span>{{end}}
            {{if eq .Role "owner"}}<sl-badge variant="success">owner</sl-badge>{{end}}
          </td>
          <td class="num">
            {{/* Ownership is what grants publishing, so it is set here.
                 Without it an organisation namespace can be created,
                 filled with members, and still be unpublishable by
                 everyone. */}}
            <form method="post" action="/admin/orgs/members/role" hx-post="/admin/orgs/members/role" hx-target="#orgs" hx-swap="outerHTML">
              <input type="hidden" name="slug" value="{{$slug}}">
              <input type="hidden" name="login" value="{{.GitHubLogin}}">
              {{if eq .Role "owner"}}
                <input type="hidden" name="role" value="member">
                <button type="submit" class="btn btn-sm">Make member</button>
              {{else}}
                <input type="hidden" name="role" value="owner">
                <button type="submit" class="btn btn-sm">Make owner</button>
              {{end}}
            </form>
            <form method="post" action="/admin/orgs/members/remove" hx-post="/admin/orgs/members/remove" hx-target="#orgs" hx-swap="outerHTML">
              <input type="hidden" name="slug" value="{{$slug}}">
              <input type="hidden" name="login" value="{{.GitHubLogin}}">
              <button type="submit" class="btn btn-sm">Remove</button>
            </form>
          </td>
        </tr>
      {{else}}
        <tr><td colspan="2" class="muted">No members yet.</td></tr>
      {{end}}
      </tbody>
    </table>

    <div class="org-actions">
      <form method="post" action="/admin/orgs/members/add" hx-post="/admin/orgs/members/add" hx-target="#orgs" hx-swap="outerHTML" class="row">
        <input type="hidden" name="slug" value="{{.Slug}}">
        <label>Add member
          <input type="text" name="login" placeholder="github-login" autocomplete="off" required>
        </label>
        <label>Role
          <select name="role">
            <option value="member">member — may import</option>
            <option value="owner">owner — may publish</option>
          </select>
        </label>
        <button type="submit" class="btn btn-sm">Add</button>
      </form>

      <form method="post" action="/admin/orgs/delete" hx-post="/admin/orgs/delete" hx-target="#orgs" hx-swap="outerHTML" class="danger">
        <input type="hidden" name="slug" value="{{.Slug}}">
        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
      </form>
    </div>
  </sl-card>
{{else}}
  <sl-card padding="lg"><p class="muted">No organisations yet. Create one above.</p></sl-card>
{{end}}
</div>
{{end}}
